# Copy to .env and fill in. Never commit .env.

# Local: SQLite file. Production: Supabase connection string, e.g.
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./kgl.db

ADMIN_EMAIL=admin@kamilightglobal.com
ADMIN_PASSWORD=change-me
JWT_SECRET=make-this-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# WhatsApp Cloud API (Meta Business Manager > WhatsApp > API setup). Empty = test mode.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=kgl-verify
WA_APP_SECRET=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Tuning
SEND_RATE_PER_SECOND=10
DORMANT_AFTER_DAYS=60
