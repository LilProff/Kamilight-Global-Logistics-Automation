# Copy to .env and fill in. Never commit .env.

# Local: SQLite file. Production: the Supabase SESSION POOLER string (Project Settings > Database >
# Connection string > Session pooler; port 5432, user postgres.<project-ref>). Do not use the direct
# db.<ref>.supabase.co address (IPv6 only) or the transaction pooler on port 6543. e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./kgl.db

# Used ONLY on the very first start, to create the first administrator. After that, accounts live in the
# database and are managed in the app (Team page). The app refuses to start in production with the default
# JWT_SECRET or a secret shorter than 32 characters.
ADMIN_EMAIL=admin@kamilightglobal.com
ADMIN_PASSWORD=change-me
JWT_SECRET=make-this-a-long-random-string-of-at-least-32-characters
# ENABLE_DOCS=false   (leave off in production)
CORS_ORIGINS=http://localhost:5173

# WhatsApp Cloud API (Meta Business Manager > WhatsApp > API setup). Empty = test mode.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=kgl-verify
WA_APP_SECRET=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Tuning
SEND_RATE_PER_SECOND=10
DORMANT_AFTER_DAYS=60
